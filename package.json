{
  "name": "dsh-video-editor",
  "version": "1.0.0",
  "private": false,
  "description": "Create, preview and edit videos with AI inside DeepSeek Harness.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "host/*.js",
    "skills/audio-creation/*.md",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "README.en.md",
    "LICENSE",
    "docs/assets/",
    "packages/video-engine-client/src/",
    "packages/video-engine-client/package.json",
    "packages/video-engine-client/README.md",
    "packages/video-engine-worker/src/",
    "packages/video-engine-worker/package.json",
    "packages/video-engine-worker/README.md",
    "packages/video-engine-worker/protocol.schema.json"
  ],
  "icon": "./icon.svg",
  "license": "MIT",
  "scripts": {
    "check": "node scripts/check.mjs && node scripts/smoke-client.mjs && node scripts/check-host.mjs",
    "stage:dev": "node scripts/stage-dev.mjs",
    "test:cr": "node scripts/test-v1-cr-regression.mjs",
    "test:collaboration": "node scripts/test-v1-reference-client.mjs && node scripts/test-v1-collaboration.mjs && node scripts/test-v1-collaboration-host.mjs && node scripts/test-v1-edit-scenarios.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/heswy/dsh-video-editor.git"
  },
  "homepage": "https://github.com/heswy/dsh-video-editor",
  "bugs": {
    "url": "https://github.com/heswy/dsh-video-editor/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "video-editor",
    "ai-video"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.2"
  },
  "dependencies": {
    "@hyperframes/sdk": "0.8.167",
    "gsap": "3.15.0",
    "hyperframes": "0.8.167",
    "linkedom": "0.18.13",
    "puppeteer-core": "25.14.0"
  }
}
